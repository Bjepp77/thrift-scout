SGW_USERNAME=your_shopgoodwill_username
SGW_PASSWORD=your_shopgoodwill_password
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
SUPABASE_URL=https://your-project.supabase.co
# Prefer the service key: this runs server-side, so it should not
# authenticate as the browser-facing anon role.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key   # fallback, legacy
